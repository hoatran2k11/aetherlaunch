# Sao chép file này thành `.env` (cùng thư mục với package.json). File `.env` đã được .gitignore.
# CHỈ điền các giá trị công khai bên dưới. KHÔNG đưa Client Secret / Bot Token của Discord vào đây.

# Bắt buộc: Application ID (Developer Portal -> General Information -> Application ID), dãy 17-20 chữ số
DISCORD_CLIENT_ID=your_application_id

# Tên ảnh (Art Assets key) đã tải lên ở Developer Portal -> Rich Presence -> Art Assets
DISCORD_LARGE_IMAGE=aether_logo
DISCORD_SMALL_IMAGE=gta_sa

# Tuỳ chọn: chữ hiện khi rê chuột vào ảnh lớn (mặc định: "AetherLaunch v<phiên bản>")
# DISCORD_LARGE_TEXT=AetherLaunch

# Tuỳ chọn: thêm 1 nút cố định (Discord cho tối đa 2 nút; nút forum của server được ưu tiên đứng trước)
DISCORD_BUTTON_LABEL=by Max Bennett
DISCORD_BUTTON_URL=https://guns.lol/aoh20119
