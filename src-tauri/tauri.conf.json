{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AetherLaunch",
  "version": "0.6.0",
  "identifier": "com.aoh20119.aetherlaunch",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AetherLaunch",
        "width": 1100,
        "height": 700,
        "minWidth": 940,
        "minHeight": 620,
        "decorations": false,
        "maximized": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "resources": ["resources/samp_helper.exe"]
  }
}
