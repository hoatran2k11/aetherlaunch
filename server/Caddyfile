# Server dữ liệu game: file tĩnh + HTTPS tự động (Let's Encrypt). Caddy hỗ trợ sẵn HTTP Range (tải tiếp khi đứt mạng).
# Đổi data.example.com thành domain của bạn (DNS phải trỏ về IP VPS này trước).
data.example.com {
	root * /srv/data
	file_server

	# manifest.json luôn lấy bản mới; file trong thư mục phiên bản (v1.0.0/...) không bao giờ đổi nên cache lâu.
	@manifest path /manifest.json
	header @manifest Cache-Control "no-cache"
	@versioned path_regexp ^/v[0-9][^/]*/
	header @versioned Cache-Control "public, max-age=31536000, immutable"

	# Không nén: file game vốn đã nén, nén thêm chỉ tốn CPU và làm sai Content-Length / Range.
	log {
		output file /var/log/caddy/access.log
	}
}
